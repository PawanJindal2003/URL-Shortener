# Production reference — DO NOT commit a real .env.prod file.
# Set these variables in the Render dashboard (or source locally via ./scripts/run-prod.sh).

SPRING_PROFILES_ACTIVE=prod

# --- Neon PostgreSQL ---
# Use the pooled JDBC URL from Neon console (hostname contains -pooler).
# Quote the URL — bash treats & as a background operator otherwise.
JDBC_URL="jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
JDBC_USERNAME=neondb_owner
JDBC_PASSWORD=your_neon_password

# --- Upstash Redis ---
# Host only — no https:// prefix
REDIS_HOST=xxxx-xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_SSL=true

# --- Frontend ---
CORS_ALLOWED_ORIGINS=https://url-sharpener.netlify.app

# Render sets PORT automatically — no need to configure manually
