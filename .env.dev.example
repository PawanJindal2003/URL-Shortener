# Copy to .env.dev and fill in your local values:
#   cp .env.dev.example .env.dev
#
# Then start the backend:
#   ./scripts/run-dev.sh

SPRING_PROFILES_ACTIVE=dev

# Local MySQL
JDBC_URL="jdbc:mysql://localhost:3306/url_shortener?serverTimezone=UTC"
JDBC_USERNAME=root
JDBC_PASSWORD=your_local_password

# Local Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional — local Redis (defaults shown)
# REDIS_HOST=localhost
# REDIS_PORT=6379
